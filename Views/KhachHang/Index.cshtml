@model List<AachSavor.Models.KhachHang>
@{
    ViewData["Title"] = "Quản lý Khách hàng";
    var invoiceCountMap = ViewBag.InvoiceCountMap as Dictionary<int, int> ?? new();
    var totalSpentMap = ViewBag.TotalSpentMap as Dictionary<int, decimal> ?? new();
    var currentKeyword = ViewBag.Keyword as string;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-people text-warning me-2"></i>Danh sách Khách hàng
        </h2>
        <p class="text-muted mb-0">Lưu trữ thông tin khách hàng thân thiết, tiệm bánh đối tác và theo dõi lịch sử mua hàng</p>
    </div>
    <button class="btn btn-brand shadow-sm d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#modalKhachHang" onclick="openCreateCustomerModal()">
        <i class="bi bi-person-plus-fill"></i> Thêm khách hàng mới
    </button>
</div>

<!-- Thanh tìm kiếm -->
<div class="card card-custom p-3 mb-4">
    <form method="get" action="/KhachHang" class="row g-2 align-items-center">
        <div class="col-md-9">
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="keyword" class="form-control" placeholder="Tìm kiếm khách hàng theo tên hoặc số điện thoại..." value="@currentKeyword">
            </div>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-dark w-100 fw-semibold">Tìm kiếm</button>
            <a href="/KhachHang" class="btn btn-outline-secondary" title="Đặt lại"><i class="bi bi-arrow-counterclockwise"></i></a>
        </div>
    </form>
</div>

<!-- Bảng danh sách khách hàng -->
<div class="card card-custom overflow-hidden">
    <div class="table-responsive">
        <table class="table table-custom table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th style="width: 100px;">Mã KH</th>
                    <th>Tên khách hàng / Tiệm bánh</th>
                    <th>Số điện thoại</th>
                    <th>Địa chỉ</th>
                    <th class="text-center">Số hóa đơn mua</th>
                    <th class="text-end">Tổng tiền chi tiêu</th>
                    <th class="text-center" style="width: 180px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-person-x fs-1 d-block mb-2"></i>
                            Không tìm thấy khách hàng nào.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var kh in Model)
                    {
                        var orderCount = invoiceCountMap.ContainsKey(kh.KhachHangID) ? invoiceCountMap[kh.KhachHangID] : 0;
                        var totalSpent = totalSpentMap.ContainsKey(kh.KhachHangID) ? totalSpentMap[kh.KhachHangID] : 0;

                        <tr>
                            <td><span class="badge bg-light text-dark border fw-bold">KH@kh.KhachHangID.ToString("D4")</span></td>
                            <td>
                                <div class="fw-bold text-dark">@kh.TenKH</div>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(kh.SDT))
                                {
                                    <span class="text-primary fw-semibold"><i class="bi bi-telephone me-1"></i>@kh.SDT</span>
                                }
                                else
                                {
                                    <span class="text-muted small">Chưa có SĐT</span>
                                }
                            </td>
                            <td class="text-muted small">@(kh.DiaChi ?? "Chưa có địa chỉ")</td>
                            <td class="text-center">
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill fw-bold">
                                    @orderCount đơn
                                </span>
                            </td>
                            <td class="text-end fw-bold text-danger">@totalSpent.ToString("N0") đ</td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-warning" title="Sửa thông tin" onclick="openEditCustomerModal(@kh.KhachHangID, '@kh.TenKH', '@kh.SDT', '@kh.DiaChi')">
                                        <i class="bi bi-pencil-square"></i> Sửa
                                    </button>
                                    <button class="btn btn-outline-info text-dark" title="Xem lịch sử mua" onclick="viewCustomerHistory(@kh.KhachHangID)">
                                        <i class="bi bi-clock-history"></i> Lịch sử
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Thêm / Sửa Khách hàng -->
<div class="modal fade" id="modalKhachHang" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <form method="post" action="/KhachHang/Save">
                @Html.AntiForgeryToken()
                <input type="hidden" name="KhachHangID" id="txtKhachHangID" value="0" />

                <div class="modal-header bg-dark text-white rounded-top-4">
                    <h5 class="modal-title fw-bold" id="modalKhTitle">
                        <i class="bi bi-person-plus text-warning me-2"></i> Thêm khách hàng mới
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Họ tên khách hàng / Tên tiệm bánh <span class="text-danger">*</span></label>
                        <input type="text" name="TenKH" id="txtTenKH" class="form-control" placeholder="VD: Nguyễn Văn An / Tiệm bánh Misa" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Số điện thoại</label>
                        <input type="text" name="SDT" id="txtSDT" class="form-control" placeholder="VD: 0912345678" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Địa chỉ giao hàng / Cơ sở</label>
                        <input type="text" name="DiaChi" id="txtDiaChi" class="form-control" placeholder="VD: 12 Hoàng Hoa Thám, Ba Đình, Hà Nội" />
                    </div>
                </div>

                <div class="modal-footer bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-brand rounded-pill px-4">
                        <i class="bi bi-check-lg me-1"></i> Lưu thông tin
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Xem Lịch Sử Mua Hàng của Khách Hàng -->
<div class="modal fade" id="modalHistory" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header bg-dark text-white rounded-top-4">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-clock-history text-warning me-2"></i> Lịch Sử Mua Hàng: <span id="hisTenKH"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="bg-light p-3 rounded-3 border mb-3 small">
                    <div><strong>Mã khách:</strong> <span id="hisMaKH"></span> &bull; <strong>SĐT:</strong> <span id="hisSDT"></span></div>
                    <div><strong>Địa chỉ:</strong> <span id="hisDiaChi"></span></div>
                </div>

                <h6 class="fw-bold text-dark mb-2">Danh sách hóa đơn đã mua:</h6>
                <div class="table-responsive border rounded-3">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Mã Hóa Đơn</th>
                                <th>Ngày mua</th>
                                <th>Phương thức TT</th>
                                <th class="text-center">Số lượng món</th>
                                <th class="text-end">Tổng tiền</th>
                            </tr>
                        </thead>
                        <tbody id="hisInvoiceBody">
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer bg-light rounded-bottom-4">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openCreateCustomerModal() {
            document.getElementById('modalKhTitle').innerHTML = '<i class="bi bi-person-plus text-warning me-2"></i> Thêm khách hàng mới';
            document.getElementById('txtKhachHangID').value = '0';
            document.getElementById('txtTenKH').value = '';
            document.getElementById('txtSDT').value = '';
            document.getElementById('txtDiaChi').value = '';
        }

        function openEditCustomerModal(id, ten, sdt, diachi) {
            document.getElementById('modalKhTitle').innerHTML = '<i class="bi bi-pencil-square text-warning me-2"></i> Cập nhật khách hàng KH' + id;
            document.getElementById('txtKhachHangID').value = id;
            document.getElementById('txtTenKH').value = ten;
            document.getElementById('txtSDT').value = sdt || '';
            document.getElementById('txtDiaChi').value = diachi || '';

            new bootstrap.Modal(document.getElementById('modalKhachHang')).show();
        }

        async function viewCustomerHistory(id) {
            try {
                const res = await fetch('/KhachHang/GetLichSuMuaHang?id=' + id);
                const data = await res.json();

                document.getElementById('hisTenKH').innerText = data.khachHang.tenKH;
                document.getElementById('hisMaKH').innerText = data.khachHang.maKH;
                document.getElementById('hisSDT').innerText = data.khachHang.sdt || 'Chưa có';
                document.getElementById('hisDiaChi').innerText = data.khachHang.diaChi || 'Chưa có';

                const tbody = document.getElementById('hisInvoiceBody');
                tbody.innerHTML = '';

                if (data.invoices.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="5" class="text-center py-4 text-muted">Khách hàng chưa có hóa đơn mua hàng nào.</td></tr>`;
                } else {
                    data.invoices.forEach(inv => {
                        const tr = document.createElement('tr');
                        tr.innerHTML = `
                            <td><strong class="text-primary">${inv.maHD}</strong></td>
                            <td>${inv.ngayLap}</td>
                            <td><span class="badge ${inv.phuongThucTT.includes('khoản') ? 'bg-info text-dark' : 'bg-success'}">${inv.phuongThucTT}</span></td>
                            <td class="text-center">${inv.soLuongSanPham}</td>
                            <td class="text-end fw-bold text-danger">${inv.tongTien.toLocaleString('vi-VN')} đ</td>
                        `;
                        tbody.appendChild(tr);
                    });
                }

                new bootstrap.Modal(document.getElementById('modalHistory')).show();
            } catch (err) {
                alert('Không thể tải lịch sử mua hàng: ' + err);
            }
        }
    </script>
}
