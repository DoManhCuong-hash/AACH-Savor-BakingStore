@using System.Security.Claims
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AACH Savor | Quản Lý Cửa Hàng Bán Đồ Làm Bánh</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap 5.3 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        :root {
            --brand-primary: #854d0e;
            --brand-primary-hover: #713f12;
            --brand-accent: #f59e0b;
            --brand-dark: #1c1917;
            --brand-surface: #fefcf8;
            --brand-card-bg: #ffffff;
            --brand-border: #f1ede4;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: #f8f6f0;
            color: #292524;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .navbar-custom {
            background: linear-gradient(135deg, #1c1917 0%, #292524 100%);
            border-bottom: 2px solid #d97706;
            padding: 0.75rem 1rem;
        }

        .navbar-brand {
            font-weight: 800;
            letter-spacing: -0.5px;
            font-size: 1.35rem;
            color: #fef3c7 !important;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .nav-link {
            font-weight: 500;
            color: #e7e5e4 !important;
            padding: 0.5rem 0.85rem !important;
            border-radius: 8px;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
        }

        .nav-link:hover, .nav-link.active {
            background-color: rgba(245, 158, 11, 0.18);
            color: #fbbf24 !important;
        }

        .badge-role-admin {
            background: linear-gradient(135deg, #f59e0b, #d97706);
            color: #fff;
            font-weight: 600;
        }

        .badge-role-staff {
            background: linear-gradient(135deg, #0ea5e9, #0284c7);
            color: #fff;
            font-weight: 600;
        }

        .card-custom {
            border: 1px solid rgba(0, 0, 0, 0.05);
            border-radius: 16px;
            background: #ffffff;
            box-shadow: 0 4px 20px -2px rgba(41, 37, 36, 0.06);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .btn-brand {
            background-color: #854d0e;
            color: #ffffff;
            border: none;
            font-weight: 600;
            border-radius: 10px;
            padding: 0.55rem 1.25rem;
            transition: all 0.2s;
        }
        .btn-brand:hover {
            background-color: #713f12;
            color: #fff;
            transform: translateY(-1px);
        }

        .btn-accent {
            background-color: #f59e0b;
            color: #1c1917;
            font-weight: 600;
            border: none;
            border-radius: 10px;
        }
        .btn-accent:hover {
            background-color: #d97706;
            color: #fff;
        }

        .table-custom thead {
            background-color: #1c1917;
            color: #fef3c7;
        }
        .table-custom thead th {
            font-weight: 600;
            border: none;
            padding: 0.85rem;
        }
        .table-custom tbody tr {
            transition: background 0.15s;
        }
        .table-custom tbody tr:hover {
            background-color: #fefce8;
        }

        .stat-card {
            border-radius: 16px;
            padding: 1.5rem;
            color: #fff;
            position: relative;
            overflow: hidden;
            border: none;
        }
        .stat-card .icon-bg {
            position: absolute;
            right: 15px;
            bottom: 10px;
            font-size: 4rem;
            opacity: 0.18;
        }

        .footer {
            margin-top: auto;
            background: #1c1917;
            color: #a8a29e;
            padding: 1.25rem 0;
            font-size: 0.875rem;
            border-top: 1px solid #44403c;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @{
        var userName = User.Identity?.Name ?? "Người dùng";
        var userRole = User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value ?? "Staff";
        var isAdmin = userRole == "Admin";
        var currentUrl = Context.Request.Path.Value?.ToLower() ?? "";
    }

    <!-- Navbar chính -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom shadow-sm sticky-top">
        <div class="container-fluid px-lg-4">
            <a class="navbar-brand" href="/">
                <span class="fs-4">🥐</span>
                <span>AACH Savor</span>
                <span class="badge bg-warning text-dark fs-6 py-1 px-2 rounded-pill fw-semibold ms-1">Baking Store</span>
            </a>
            
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link @(currentUrl == "/" || currentUrl.StartsWith("/home") ? "active" : "")" href="/">
                            <i class="bi bi-speedometer2"></i> Trang chủ
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentUrl.StartsWith("/banhang") ? "active" : "")" href="/BanHang">
                            <i class="bi bi-cart-check-fill text-warning"></i> <strong>Bán hàng</strong>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentUrl.StartsWith("/chotca") ? "active" : "")" href="/ChotCa">
                            <i class="bi bi-journal-check text-info"></i> Chốt ca trực
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentUrl.StartsWith("/sanpham") ? "active" : "")" href="/SanPham">
                            <i class="bi bi-box-seam"></i> Sản phẩm
                        </a>
                    </li>
                    @if (isAdmin)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(currentUrl.StartsWith("/nhapkho") ? "active" : "")" href="/NhapKho">
                                <i class="bi bi-box-arrow-in-down"></i> Nhập kho
                            </a>
                        </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link @(currentUrl.StartsWith("/khachhang") ? "active" : "")" href="/KhachHang">
                            <i class="bi bi-people"></i> Khách hàng
                        </a>
                    </li>
                    @if (isAdmin)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(currentUrl.StartsWith("/baocao") ? "active" : "")" href="/BaoCao">
                                <i class="bi bi-graph-up-arrow"></i> Báo cáo
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentUrl.StartsWith("/nhanvien") ? "active" : "")" href="/NhanVien">
                                <i class="bi bi-person-badge"></i> Nhân viên
                            </a>
                        </li>
                    }
                </ul>

                <!-- User profile, Change Password & Logout -->
                <div class="d-flex align-items-center gap-2">
                    <div class="dropdown">
                        <button class="btn btn-dark bg-transparent border-0 d-flex align-items-center gap-2 text-start p-1 rounded-pill" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="outline: none;">
                            <div class="rounded-circle @(isAdmin ? "bg-warning text-dark" : "bg-primary text-white") fw-bold d-flex align-items-center justify-content-center shadow-sm" style="width: 38px; height: 38px;">
                                @(userName.Length > 0 ? userName.Substring(0, 1).ToUpper() : "U")
                            </div>
                            <div class="d-none d-sm-block me-1">
                                <div class="fw-bold fs-7 lh-sm text-amber-200">@userName <i class="bi bi-chevron-down ms-1 text-muted" style="font-size: 0.75rem;"></i></div>
                                <small class="badge @(isAdmin ? "badge-role-admin" : "badge-role-staff") rounded-pill py-0 px-2">
                                    <i class="bi @(isAdmin ? "bi-shield-lock" : "bi-person")"></i> @userRole
                                </small>
                            </div>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3 mt-2 py-2" style="min-width: 220px;">
                            <li class="px-3 py-2 border-bottom">
                                <div class="fw-bold text-dark">@userName</div>
                                <div class="text-muted small">Phân quyền: <span class="badge @(isAdmin ? "badge-role-admin" : "badge-role-staff")">@userRole</span></div>
                            </li>
                            <li>
                                <a class="dropdown-item py-2 d-flex align-items-center gap-2" href="javascript:void(0)" data-bs-toggle="modal" data-bs-target="#modalDoiMatKhauQuick">
                                    <i class="bi bi-key-fill text-warning fs-5"></i>
                                    <span>Đổi mật khẩu nhanh</span>
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2 d-flex align-items-center gap-2" href="/Account/ChangePassword">
                                    <i class="bi bi-shield-lock text-primary fs-5"></i>
                                    <span>Trang đổi mật khẩu</span>
                                </a>
                            </li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li>
                                <a class="dropdown-item py-2 d-flex align-items-center gap-2 text-danger" href="/Account/Logout">
                                    <i class="bi bi-box-arrow-right fs-5"></i>
                                    <span>Đăng xuất</span>
                                </a>
                            </li>
                        </ul>
                    </div>

                    <button class="btn btn-outline-warning btn-sm rounded-pill px-3 py-1 fw-semibold d-none d-md-inline-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#modalDoiMatKhauQuick" title="Đổi mật khẩu tài khoản">
                        <i class="bi bi-key-fill"></i> Đổi MK
                    </button>

                    <a href="/Account/Logout" class="btn btn-outline-light btn-sm rounded-pill px-3 py-1 fw-semibold" title="Đăng xuất">
                        <i class="bi bi-box-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Thông báo nổi TempData (Flash messages) -->
    <div class="container-fluid px-lg-4 mt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3 d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-check-circle-fill fs-5 text-success"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 rounded-3 d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <!-- Main Content Area -->
    <main class="container-fluid px-lg-4 my-3 flex-grow-1">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="container-fluid px-lg-4 d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
            <div>
                <strong>AACH Savor</strong> &bull; Hệ thống quản lý bán lẻ & kho nguyên liệu làm bánh chuyên nghiệp
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="text-success"><i class="bi bi-record-circle-fill"></i> Hệ thống sẵn sàng</span>
                <span>ASP.NET Core MVC 10 &bull; SQL Server</span>
            </div>
        </div>
    </footer>

    <!-- Modal Đổi Mật Khẩu Nhanh (Sử dụng được trên toàn bộ các trang) -->
    <div class="modal fade" id="modalDoiMatKhauQuick" tabindex="-1" aria-labelledby="modalDoiMatKhauLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-warning bg-opacity-25 border-bottom border-warning border-opacity-25 py-3">
                    <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2" id="modalDoiMatKhauLabel">
                        <i class="bi bi-shield-lock-fill text-warning fs-4"></i> Đổi mật khẩu tài khoản
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div id="quickPassAlert" class="alert d-none mb-3 small" role="alert"></div>

                    <form id="formQuickChangePassword" onsubmit="handleQuickChangePassword(event)">
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary small">
                                <i class="bi bi-key me-1"></i> Mật khẩu hiện tại <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <input type="password" class="form-control" id="quickOldPass" placeholder="Nhập mật khẩu đang dùng" required autocomplete="current-password" />
                                <button class="btn btn-outline-secondary" type="button" onclick="toggleQuickPass('quickOldPass', 'iconQuickOld')">
                                    <i class="bi bi-eye" id="iconQuickOld"></i>
                                </button>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary small">
                                <i class="bi bi-lock me-1"></i> Mật khẩu mới <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <input type="password" class="form-control" id="quickNewPass" placeholder="Tối thiểu 4 ký tự" required autocomplete="new-password" minlength="4" />
                                <button class="btn btn-outline-secondary" type="button" onclick="toggleQuickPass('quickNewPass', 'iconQuickNew')">
                                    <i class="bi bi-eye" id="iconQuickNew"></i>
                                </button>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary small">
                                <i class="bi bi-check2-circle me-1"></i> Nhập lại mật khẩu mới <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <input type="password" class="form-control" id="quickConfirmPass" placeholder="Xác nhận mật khẩu mới" required autocomplete="new-password" minlength="4" />
                                <button class="btn btn-outline-secondary" type="button" onclick="toggleQuickPass('quickConfirmPass', 'iconQuickConfirm')">
                                    <i class="bi bi-eye" id="iconQuickConfirm"></i>
                                </button>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-2">
                            <a href="/Account/ChangePassword" class="text-decoration-none small text-muted">
                                <i class="bi bi-box-arrow-up-right me-1"></i>Mở trang riêng
                            </a>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-light border px-3" data-bs-dismiss="modal">Hủy</button>
                                <button type="submit" class="btn btn-brand px-3" id="btnSubmitQuickPass">
                                    <span class="spinner-border spinner-border-sm d-none me-1" id="spinnerQuickPass"></span>
                                    <span>Lưu mật khẩu</span>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleQuickPass(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (!input || !icon) return;
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }

        async function handleQuickChangePassword(e) {
            e.preventDefault();
            const oldPass = document.getElementById('quickOldPass').value;
            const newPass = document.getElementById('quickNewPass').value;
            const confirmPass = document.getElementById('quickConfirmPass').value;
            const alertBox = document.getElementById('quickPassAlert');
            const btnSubmit = document.getElementById('btnSubmitQuickPass');
            const spinner = document.getElementById('spinnerQuickPass');

            alertBox.className = 'alert d-none mb-3 small';
            alertBox.innerText = '';

            if (!oldPass || !newPass || !confirmPass) {
                alertBox.className = 'alert alert-danger mb-3 small';
                alertBox.innerText = 'Vui lòng điền đầy đủ các trường thông tin!';
                return;
            }

            if (newPass.length < 4) {
                alertBox.className = 'alert alert-danger mb-3 small';
                alertBox.innerText = 'Mật khẩu mới phải có tối thiểu 4 ký tự!';
                return;
            }

            if (newPass !== confirmPass) {
                alertBox.className = 'alert alert-danger mb-3 small';
                alertBox.innerText = 'Mật khẩu xác nhận không khớp với mật khẩu mới!';
                return;
            }

            btnSubmit.disabled = true;
            spinner.classList.remove('d-none');

            try {
                const res = await fetch('/Account/ChangePasswordApi', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        matKhauHienTai: oldPass,
                        matKhauMoi: newPass,
                        xacNhanMatKhauMoi: confirmPass
                    })
                });

                const data = await res.json();
                if (res.ok && data.success) {
                    alertBox.className = 'alert alert-success mb-3 small';
                    alertBox.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> ' + data.message;
                    document.getElementById('formQuickChangePassword').reset();
                    setTimeout(() => {
                        const modalEl = document.getElementById('modalDoiMatKhauQuick');
                        const modalInstance = bootstrap.Modal.getInstance(modalEl);
                        if (modalInstance) modalInstance.hide();
                        alertBox.className = 'alert d-none mb-3 small';
                    }, 1500);
                } else {
                    alertBox.className = 'alert alert-danger mb-3 small';
                    alertBox.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i> ' + (data.message || 'Đổi mật khẩu thất bại!');
                }
            } catch (err) {
                alertBox.className = 'alert alert-danger mb-3 small';
                alertBox.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i> Không thể kết nối tới máy chủ!';
            } finally {
                btnSubmit.disabled = false;
                spinner.classList.add('d-none');
            }
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
