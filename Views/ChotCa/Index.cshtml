@model List<AachSavor.Models.ChotCa>
@{
    ViewData["Title"] = "Quản lý Chốt Ca Trực";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-clock-history text-warning me-2"></i>Lịch Sử Chốt Doanh Thu Ca Trực
        </h2>
        <p class="text-muted mb-0">Theo dõi đối soát két tiền, tiền hàng và chi phí phát sinh sau mỗi ca trực bán hàng</p>
    </div>
    <a href="/ChotCa/Create" class="btn btn-danger shadow-sm d-flex align-items-center gap-2 px-3 py-2 fw-bold">
        <i class="bi bi-plus-circle-fill"></i> Chốt ca trực mới (Sale Report)
    </a>
</div>

<!-- Thẻ thống kê chốt ca -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card card-custom p-3 border-start border-4 border-primary">
            <div class="small text-muted fw-semibold">Tổng số ca đã chốt</div>
            <div class="fs-4 fw-bold text-dark">@Model.Count ca trực</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-custom p-3 border-start border-4 border-success">
            <div class="small text-muted fw-semibold">Tổng tiền hàng các ca</div>
            <div class="fs-4 fw-bold text-success">@Model.Sum(c => c.TienHang).ToString("N0") đ</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-custom p-3 border-start border-4 border-danger">
            <div class="small text-muted fw-semibold">Tổng tiền mặt đã bàn giao</div>
            <div class="fs-4 fw-bold text-danger">@Model.Sum(c => c.TongTienCanChuyen).ToString("N0") đ</div>
        </div>
    </div>
</div>

<!-- Bảng danh sách ca trực đã chốt -->
<div class="card card-custom overflow-hidden">
    <div class="table-responsive">
        <table class="table table-custom table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th style="width: 90px;">Mã Ca</th>
                    <th>Thời gian chốt</th>
                    <th>Ca trực</th>
                    <th>Nhân viên thu ngân</th>
                    <th>Nhiệt độ tủ mát</th>
                    <th class="text-end">Tiền hàng</th>
                    <th class="text-end">Tiền két cuối ca</th>
                    <th class="text-end">Tiền bàn giao</th>
                    <th class="text-center" style="width: 120px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-clock fs-1 d-block mb-2"></i>
                            Chưa có dữ liệu chốt ca trực nào. Hãy bấm "Chốt ca trực mới" để lập báo cáo.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td><span class="badge bg-light text-dark border fw-bold">CA@c.ChotCaID.ToString("D4")</span></td>
                            <td>@c.NgayChot.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <span class="badge @(c.CaTruc == "Sáng" ? "bg-warning text-dark" : (c.CaTruc == "Chiều" ? "bg-primary" : "bg-dark")) px-2 py-1 rounded-pill">
                                    Ca @c.CaTruc
                                </span>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@(c.NhanVien?.TenNV ?? "Nhân viên")</div>
                            </td>
                            <td><span class="badge bg-info-subtle text-info border">@c.NhietDoTuMat</span></td>
                            <td class="text-end fw-bold text-success">@c.TienHang.ToString("N0") đ</td>
                            <td class="text-end fw-bold text-dark">@c.TongTienKetCuoiCa.ToString("N0") đ</td>
                            <td class="text-end fw-bold text-danger">@c.TongTienCanChuyen.ToString("N0") đ</td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="viewChotCaDetail(@c.ChotCaID)">
                                    <i class="bi bi-eye"></i> Chi tiết
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Xem Chi Tiết Báo Cáo Chốt Ca -->
<div class="modal fade" id="modalChotCaDetail" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg" style="background: #18181b; color: #f4f4f5;">
            <div class="modal-header border-secondary">
                <h5 class="modal-title fw-bold text-white">
                    <i class="bi bi-file-earmark-spreadsheet text-warning me-2"></i> Chi Tiết Chốt Ca: <span id="dtlMaCa"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="p-3 bg-dark rounded border border-secondary mb-3 small">
                    <div class="d-flex justify-content-between mb-1">
                        <span>Cơ sở: <strong id="dtlCoSo" class="text-white"></strong></span>
                        <span>Ca: <strong id="dtlCaTruc" class="text-warning"></strong></span>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span>Thu ngân: <strong id="dtlNhanVien" class="text-white"></strong></span>
                        <span>Tủ mát: <strong id="dtlNhietDo" class="text-info"></strong></span>
                    </div>
                    <div>Thời gian: <span id="dtlNgayChot" class="text-white-50"></span></div>
                </div>

                <h6 class="fw-bold text-white mb-2">Bảng tổng kết tài chính ca trực:</h6>
                <table class="table table-sm table-dark table-borderless small mb-3">
                    <tbody>
                        <tr><td>Tiền lẻ đầu ca:</td><td class="text-end fw-bold" id="dtlTienLe"></td></tr>
                        <tr><td class="text-success">+ Tiền hàng bán được:</td><td class="text-end fw-bold text-success" id="dtlTienHang"></td></tr>
                        <tr><td>+ Chênh lệch ship:</td><td class="text-end" id="dtlShip"></td></tr>
                        <tr><td class="text-danger">- Chi phí trích từ két:</td><td class="text-end text-danger" id="dtlChiPhi"></td></tr>
                        <tr><td class="text-white-50 ps-3 fst-italic" colspan="2" id="dtlChiPhiMoTa"></td></tr>
                        <tr><td>- Chiết khấu đối tác:</td><td class="text-end" id="dtlChietKhau"></td></tr>
                        <tr><td>- Phải thu sau đối tác:</td><td class="text-end" id="dtlPhaiThuSau"></td></tr>
                        <tr><td class="text-info">- Chuyển khoản / Quẹt thẻ:</td><td class="text-end text-info" id="dtlQuetThe"></td></tr>
                        <tr class="border-top border-secondary"><td class="fw-bold text-warning fs-6">= Tổng tiền két cuối ca:</td><td class="text-end fw-bold text-warning fs-6" id="dtlTongKet"></td></tr>
                        <tr><td class="fw-bold text-success fs-6">Tổng tiền cần bàn giao:</td><td class="text-end fw-bold text-success fs-6" id="dtlTienChuyen"></td></tr>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function viewChotCaDetail(id) {
            try {
                const res = await fetch('/ChotCa/GetDetailJson?id=' + id);
                const d = await res.json();

                document.getElementById('dtlMaCa').innerText = d.maCa;
                document.getElementById('dtlCoSo').innerText = d.coSo;
                document.getElementById('dtlCaTruc').innerText = d.caTruc;
                document.getElementById('dtlNhanVien').innerText = d.nhanVien;
                document.getElementById('dtlNhietDo').innerText = d.nhietDoTuMat;
                document.getElementById('dtlNgayChot').innerText = d.ngayChot;

                document.getElementById('dtlTienLe').innerText = d.tienLeDauCa.toLocaleString('vi-VN') + ' đ';
                document.getElementById('dtlTienHang').innerText = d.tienHang.toLocaleString('vi-VN') + ' đ';
                document.getElementById('dtlShip').innerText = d.chenhLechShip.toLocaleString('vi-VN') + ' đ';
                document.getElementById('dtlChiPhi').innerText = d.chiPhi.toLocaleString('vi-VN') + ' đ';
                document.getElementById('dtlChiPhiMoTa').innerText = d.chiPhiMoTa ? `(${d.chiPhiMoTa})` : '';
                document.getElementById('dtlChietKhau').innerText = d.chietKhauDoiTac.toLocaleString('vi-VN') + ' đ';
                document.getElementById('dtlPhaiThuSau').innerText = d.phaiThuSauDoiTac.toLocaleString('vi-VN') + ' đ';
                document.getElementById('dtlQuetThe').innerText = d.quetTheChuyenKhoan.toLocaleString('vi-VN') + ' đ';
                document.getElementById('dtlTongKet').innerText = d.tongTienKetCuoiCa.toLocaleString('vi-VN') + ' đ';
                document.getElementById('dtlTienChuyen').innerText = d.tongTienCanChuyen.toLocaleString('vi-VN') + ' đ';

                new bootstrap.Modal(document.getElementById('modalChotCaDetail')).show();
            } catch (err) {
                alert('Không thể tải chi tiết ca trực: ' + err);
            }
        }
    </script>
}
