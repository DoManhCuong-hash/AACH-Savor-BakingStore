@model AachSavor.Models.DashboardViewModel
@{
    ViewData["Title"] = "Trang chủ Bảng điều khiển";
    var isAdmin = User.IsInRole("Admin");
    var currentNv = Model.CurrentNhanVien;
    var points = currentNv?.DiemTichLuy ?? 0;
    var (rank, nextRankTarget, prevRankTarget) = AachSavor.Models.RankHelper.GetRankInfo(points);
    int range = nextRankTarget - prevRankTarget;
    int progressPercent = range > 0 ? Math.Min(100, Math.Max(0, (int)((points - prevRankTarget) * 100.0 / range))) : 100;
}

<!-- 1. Băng chuyền thông báo hệ thống phong cách AACH Savor (4handy Story style) -->
<div class="card card-custom bg-dark text-white border-0 shadow-sm mb-4 py-3 px-4" style="background: linear-gradient(135deg, #1c1917 0%, #292524 60%, #451a03 100%) !important;">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
        <div class="d-flex align-items-center gap-3">
            <span class="fs-1">🥐</span>
            <div>
                <h4 class="fw-bold text-warning mb-1">Hệ thống Quản lý AACH Savor</h4>
                <p class="text-white-50 mb-0">Hệ thống quản lý bán lẻ, kho và chốt ca thu ngân vận hành ổn định và chính xác.</p>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a href="/BanHang" class="btn btn-warning fw-bold text-dark rounded-pill px-3 py-2">
                <i class="bi bi-cart3 me-1"></i> Bán hàng ngay
            </a>
            <a href="/ChotCa/Create" class="btn btn-danger fw-bold rounded-pill px-3 py-2">
                <i class="bi bi-journal-check me-1"></i> Chốt ca trực
            </a>
            @if (isAdmin)
            {
                <a href="/NhapKho" class="btn btn-outline-light rounded-pill px-3 py-2">
                    <i class="bi bi-box-arrow-in-down me-1"></i> Nhập kho
                </a>
            }
        </div>
    </div>
</div>

<!-- 2. Thẻ chỉ số tổng quan -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card" style="background: linear-gradient(135deg, #2563eb, #1d4ed8);">
            <div class="fs-6 text-white-50 fw-semibold text-uppercase">Sản phẩm trong kho</div>
            <div class="display-6 fw-bold mt-1">@Model.TongSanPham</div>
            <small class="text-white-70 mt-1 d-block"><i class="bi bi-boxes"></i> Đang theo dõi tồn kho</small>
            <i class="bi bi-box-seam icon-bg"></i>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="stat-card" style="background: linear-gradient(135deg, #16a34a, #15803d);">
            <div class="fs-6 text-white-50 fw-semibold text-uppercase">Doanh thu hôm nay</div>
            <div class="display-6 fw-bold mt-1">@Model.DoanhThuHomNay.ToString("N0") đ</div>
            <small class="text-white-70 mt-1 d-block"><i class="bi bi-receipt"></i> @Model.SoDonHangHomNay đơn hàng thành công</small>
            <i class="bi bi-cash-stack icon-bg"></i>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="stat-card" style="background: linear-gradient(135deg, #d97706, #b45309);">
            <div class="fs-6 text-white-50 fw-semibold text-uppercase">Nhân sự hoạt động</div>
            <div class="display-6 fw-bold mt-1">@Model.TongNhanVien</div>
            <small class="text-white-70 mt-1 d-block"><i class="bi bi-person-check"></i> Đang phân ca trực</small>
            <i class="bi bi-people icon-bg"></i>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="stat-card" style="background: linear-gradient(135deg, #e11d48, #be123c);">
            <div class="fs-6 text-white-50 fw-semibold text-uppercase">Cảnh báo sắp hết</div>
            <div class="display-6 fw-bold mt-1">@Model.SanPhamSapHet</div>
            <small class="text-white-70 mt-1 d-block"><i class="bi bi-exclamation-triangle"></i> Tồn kho ≤ 20 đơn vị</small>
            <i class="bi bi-bell-fill icon-bg"></i>
        </div>
    </div>
</div>

<!-- 3. Khu vực bảng dữ liệu thời gian thực -->
<div class="row g-4 mb-4">
    <!-- Cột trái: Đơn hàng mới nhất -->
    <div class="col-lg-7">
        <div class="card card-custom p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-clock-history text-primary me-2"></i>Đơn hàng bán lẻ gần đây</h5>
                <a href="/BanHang" class="btn btn-sm btn-outline-primary rounded-pill">Tạo đơn mới</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="small text-muted">
                            <th>Mã HĐ</th>
                            <th>Thời gian</th>
                            <th>Khách hàng</th>
                            <th>Tổng tiền</th>
                            <th>Thanh toán</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.HoaDonGanDay.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">Chưa có giao dịch nào trong ngày.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var hd in Model.HoaDonGanDay)
                            {
                                <tr>
                                    <td><strong class="text-primary">HD@hd.HoaDonID.ToString("D5")</strong></td>
                                    <td class="small text-muted">@hd.NgayLap.ToString("dd/MM HH:mm")</td>
                                    <td>@(hd.KhachHang?.TenKH ?? "Khách vãng lai")</td>
                                    <td><strong class="text-danger">@hd.TongTien.ToString("N0") đ</strong></td>
                                    <td>
                                        @if (hd.PhuongThucTT.Contains("khoản", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill">
                                                <i class="bi bi-qr-code"></i> Chuyển khoản
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle rounded-pill">
                                                <i class="bi bi-cash"></i> Tiền mặt
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Cột phải: Sản phẩm cần bổ sung tồn kho -->
    <div class="col-lg-5">
        <div class="card card-custom p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-exclamation-octagon text-danger me-2"></i>Tồn kho cần lưu ý</h5>
                <a href="/SanPham?sapHetHang=true" class="small text-decoration-none">Xem tất cả</a>
            </div>
            <div class="list-group list-group-flush">
                @foreach (var sp in Model.TopSanPhamDashboard)
                {
                    <div class="list-group-item px-0 d-flex justify-content-between align-items-center">
                        <div class="me-2">
                            <div class="fw-semibold text-dark">@sp.HinhAnh @sp.TenSP</div>
                            <small class="text-muted">Mã: @sp.MaSP &bull; ĐVT: @sp.DonViTinh</small>
                        </div>
                        <span class="badge @(sp.TonKho <= 15 ? "bg-danger" : "bg-warning text-dark") rounded-pill px-3 py-2 fs-7">
                            Còn: @sp.TonKho
                        </span>
                    </div>
                }
            </div>
            @if (isAdmin)
            {
                <div class="mt-3 text-end">
                    <a href="/NhapKho" class="btn btn-sm btn-outline-danger rounded-pill">
                        <i class="bi bi-plus-circle me-1"></i> Lập phiếu nhập kho ngay
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<!-- 4. Khu vực Ca trực & Gamification: Rank & Thumb Up thưởng nhân viên -->
<div class="row g-4">
    <!-- Cột trái: 5 Ca trực gần nhất -->
    <div class="col-lg-7">
        <div class="card card-custom p-4 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-calendar3 me-2 text-warning"></i>5 ca trực gần đây nhất</h5>
                <a href="/ChotCa" class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill text-decoration-none px-3 py-2">
                    <i class="bi bi-journal-check"></i> Xem danh sách chốt ca
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-bordered text-center align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Ca trực</th>
                            <th>17/11 Chiều</th>
                            <th>16/11 Tối</th>
                            <th>15/11 Sáng</th>
                            <th>14/11 Tối</th>
                            <th>13/11 Chiều</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="fw-semibold bg-light">Feedback</td>
                            <td><span class="badge bg-primary-subtle text-primary border">Viết Feedback</span></td>
                            <td><span class="text-secondary small">#1176741</span></td>
                            <td><span class="badge bg-primary-subtle text-primary border">Viết Feedback</span></td>
                            <td><span class="badge bg-primary-subtle text-primary border">Viết Feedback</span></td>
                            <td><span class="text-secondary small">#1176605</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Tab điều hướng ca trực -->
            <ul class="nav nav-pills mt-4 gap-2">
                <li class="nav-item"><a class="nav-link active bg-dark text-white rounded-pill px-3" href="javascript:void(0);">Points</a></li>
                <li class="nav-item"><a class="nav-link bg-light text-dark rounded-pill px-3" href="/ChotCa">Chốt ca</a></li>
                <li class="nav-item"><a class="nav-link bg-light text-dark rounded-pill px-3" href="javascript:void(0);">User Notes</a></li>
                <li class="nav-item"><a class="nav-link bg-light text-dark rounded-pill px-3" href="javascript:void(0);">KQCV</a></li>
                <li class="nav-item"><a class="nav-link bg-light text-dark rounded-pill px-3" href="javascript:void(0);">Cake Items</a></li>
            </ul>

            <div class="alert alert-secondary mt-3 mb-0 d-flex justify-content-between align-items-center rounded-3">
                <span>📅 <strong>Cơ sở chính:</strong> 128 Cầu Giấy &bull; Cửa hàng bán đồ làm bánh AACH Savor</span>
                <span class="badge bg-success">Hệ thống sẵn sàng</span>
            </div>
        </div>
    </div>

    <!-- Cột phải: Xếp hạng & Thumb Up Thưởng Nhân Viên -->
    <div class="col-lg-5">
        <div class="card card-custom p-4 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-primary mb-0"><i class="bi bi-star-fill text-warning me-2"></i>Xếp hạng nhân sự</h5>
                @if (isAdmin)
                {
                    <button class="btn btn-sm btn-warning text-dark fw-bold rounded-pill shadow-sm" data-bs-toggle="modal" data-bs-target="#modalSendThumbUp">
                        <i class="bi bi-hand-thumbs-up-fill me-1"></i> Thưởng Thumb Up
                    </button>
                }
            </div>

            <div class="p-3 bg-light rounded-3 mb-3 border">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <h5 class="fw-bold text-dark mb-0">@(currentNv?.TenNV ?? "Nhân viên") (Rank @rank)</h5>
                    <span class="badge bg-warning text-dark fw-bold">Rank @rank</span>
                </div>
                <p class="text-muted mb-2 small">
                    Điểm hiện có: <strong class="text-primary">@points điểm</strong>. 
                    @if (rank == "A8")
                    {
                        <span>Đã đạt <strong>Rank tối đa (A8)</strong>!</span>
                    }
                    else
                    {
                        <span>Mốc xét lên Rank kế tiếp: <strong>@nextRankTarget điểm</strong></span>
                    }
                </p>
                <div class="progress" style="height: 10px;">
                    <div class="progress-bar bg-warning progress-bar-striped progress-bar-animated" role="progressbar" style="width: @progressPercent%;" aria-valuenow="@progressPercent" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
                <small class="text-muted mt-1 d-block text-end">Tiến trình hạng: @progressPercent%</small>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="fw-bold text-dark mb-0"><i class="bi bi-gift-fill text-danger me-1"></i> Thưởng khích lệ (Thumb Up) gần đây</h6>
                <small class="text-muted">@Model.ThumbUpGanDay.Count lượt thưởng</small>
            </div>

            <ul class="list-group list-group-flush small" id="listThumbUpContainer">
                @if (Model.ThumbUpGanDay.Count == 0)
                {
                    <li class="list-group-item px-0 text-muted text-center py-3">Chưa có lượt thưởng nào.</li>
                }
                else
                {
                    @foreach (var tu in Model.ThumbUpGanDay)
                    {
                        <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                            <div>
                                <span class="fw-semibold text-dark">👍 @tu.NoiDung</span>
                                <small class="text-muted d-block">Bởi @tu.NguoiGuiTen &bull; @tu.NgayGui.ToString("dd/MM HH:mm")</small>
                            </div>
                            <span class="badge bg-success rounded-pill px-2 py-1">+@tu.TienThuong.ToString("N0") đ (+@tu.DiemThuong đ)</span>
                        </li>
                    }
                }
            </ul>
        </div>
    </div>
</div>

<!-- Modal Gửi Thumb Up Thưởng Nhân Viên (Dành riêng cho Admin / Quản lý) -->
@if (isAdmin)
{
    <div class="modal fade" id="modalSendThumbUp" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow-lg">
                <div class="modal-header bg-dark text-white rounded-top-4">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-hand-thumbs-up-fill text-warning me-2"></i> Gửi Thumb Up Khen Thưởng Nhân Viên
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Chọn nhân viên nhận thưởng <span class="text-danger">*</span></label>
                        <select id="selThumbUpNhanVien" class="form-select">
                            @foreach (var nv in Model.DanhSachNhanVien)
                            {
                                <option value="@nv.NhanVienID">@nv.TenNV (Rank: @nv.Rank - @nv.DiemTichLuy điểm)</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Lý do / Nội dung khen thưởng <span class="text-danger">*</span></label>
                        <input type="text" id="txtThumbUpNoiDung" class="form-control" placeholder="VD: Hỗ trợ cơ sở thiếu người ca tối / Dọn tủ đông..." value="Bán hàng xuất sắc vượt chỉ tiêu ca" required>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Mức tiền thưởng (đ)</label>
                            <select id="selThumbUpTien" class="form-select">
                                <option value="20000">+20,000 đ</option>
                                <option value="50000" selected>+50,000 đ</option>
                                <option value="100000">+100,000 đ</option>
                                <option value="200000">+200,000 đ</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Điểm xếp hạng (+Points)</label>
                            <select id="selThumbUpDiem" class="form-select">
                                <option value="20">+20 điểm</option>
                                <option value="50" selected>+50 điểm</option>
                                <option value="100">+100 điểm</option>
                            </select>
                        </div>
                    </div>

                    <div class="alert alert-light border small text-muted mb-0">
                        <i class="bi bi-info-circle text-primary"></i> Nhân viên sẽ nhận được thông báo thưởng khích lệ và điểm xếp hạng sẽ được cộng tự động vào hồ sơ cá nhân.
                    </div>
                </div>
                <div class="modal-footer bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn btn-warning text-dark fw-bold rounded-pill px-4" onclick="submitThumbUp()">
                        <i class="bi bi-hand-thumbs-up-fill me-1"></i> Gửi Thumb Up ngay
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        async function submitThumbUp() {
            const nvId = parseInt(document.getElementById('selThumbUpNhanVien').value);
            const content = document.getElementById('txtThumbUpNoiDung').value.trim();
            const money = parseFloat(document.getElementById('selThumbUpTien').value) || 20000;
            const points = parseInt(document.getElementById('selThumbUpDiem').value) || 50;

            if (!content) {
                alert('Vui lòng nhập nội dung khen thưởng!');
                return;
            }

            try {
                const res = await fetch('/Home/SendThumbUp', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        NhanVienID: nvId,
                        NoiDung: content,
                        TienThuong: money,
                        DiemThuong: points
                    })
                });

                if (!res.ok) {
                    alert('Lỗi máy chủ (' + res.status + '): Không thể gửi khen thưởng.');
                    return;
                }

                const data = await res.json();
                if (data.success) {
                    alert(data.message);
                    window.location.reload();
                } else {
                    alert('Lỗi: ' + data.message);
                }
            } catch (err) {
                alert('Lỗi kết nối máy chủ: ' + err);
            }
        }
    </script>
}
