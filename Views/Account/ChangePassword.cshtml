@model AachSavor.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
    var userName = User.Identity?.Name ?? "Người dùng";
    var userRole = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "Staff";
    var loginUsername = User.Claims.FirstOrDefault(c => c.Type == "Username")?.Value ?? (userRole == "Admin" ? "admin" : "staff");
    var isAdmin = userRole == "Admin";
}

<div class="row justify-content-center">
    <div class="col-lg-9 col-xl-8">
        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted"><i class="bi bi-house-door"></i> Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="javascript:void(0)" class="text-decoration-none text-muted">Tài khoản</a></li>
                <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Đổi mật khẩu</li>
            </ol>
        </nav>

        <div class="row g-4">
            <!-- Cột trái: Form đổi mật khẩu -->
            <div class="col-md-7">
                <div class="card card-custom h-100">
                    <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                        <div class="d-flex align-items-center gap-3 mb-2">
                            <div class="rounded-circle bg-warning bg-opacity-25 text-warning fw-bold d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; font-size: 1.5rem;">
                                <i class="bi bi-shield-lock-fill text-warning"></i>
                            </div>
                            <div>
                                <h4 class="fw-bold text-dark mb-0">Đổi mật khẩu</h4>
                                <small class="text-muted">Cập nhật mật khẩu để bảo vệ tài khoản cá nhân</small>
                            </div>
                        </div>
                    </div>

                    <div class="card-body px-4 pt-3 pb-4">
                        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""]?.Errors.Count > 0)
                        {
                            <div class="alert alert-danger alert-dismissible fade show rounded-3 py-2 px-3 mb-3 small" role="alert">
                                <i class="bi bi-exclamation-circle-fill me-1"></i>
                                @foreach (var err in ViewData.ModelState[""]!.Errors)
                                {
                                    <span>@err.ErrorMessage</span>
                                }
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        }

                        <form asp-action="ChangePassword" asp-controller="Account" method="post" id="formChangePassword">
                            @Html.AntiForgeryToken()

                            <!-- Mật khẩu hiện tại -->
                            <div class="mb-3">
                                <label asp-for="MatKhauHienTai" class="form-label fw-semibold text-secondary small">
                                    <i class="bi bi-key me-1"></i> Mật khẩu hiện tại <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <input asp-for="MatKhauHienTai" type="password" class="form-control" id="inputOldPassword" placeholder="Nhập mật khẩu đang dùng" required />
                                    <button class="btn btn-outline-secondary" type="button" onclick="togglePassVisibility('inputOldPassword', 'iconOld')">
                                        <i class="bi bi-eye" id="iconOld"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="MatKhauHienTai" class="text-danger small"></span>
                            </div>

                            <hr class="my-3 text-muted opacity-25">

                            <!-- Mật khẩu mới -->
                            <div class="mb-3">
                                <label asp-for="MatKhauMoi" class="form-label fw-semibold text-secondary small">
                                    <i class="bi bi-lock me-1"></i> Mật khẩu mới <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <input asp-for="MatKhauMoi" type="password" class="form-control" id="inputNewPassword" placeholder="Tối thiểu 4 ký tự" required />
                                    <button class="btn btn-outline-secondary" type="button" onclick="togglePassVisibility('inputNewPassword', 'iconNew')">
                                        <i class="bi bi-eye" id="iconNew"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="MatKhauMoi" class="text-danger small"></span>
                                <div class="form-text small text-muted">
                                    <i class="bi bi-info-circle me-1"></i>Mật khẩu nên chứa từ 4-32 ký tự, không nên trùng với mật khẩu cũ.
                                </div>
                            </div>

                            <!-- Xác nhận mật khẩu mới -->
                            <div class="mb-4">
                                <label asp-for="XacNhanMatKhauMoi" class="form-label fw-semibold text-secondary small">
                                    <i class="bi bi-check2-circle me-1"></i> Nhập lại mật khẩu mới <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <input asp-for="XacNhanMatKhauMoi" type="password" class="form-control" id="inputConfirmPassword" placeholder="Nhập lại mật khẩu mới vừa gõ" required />
                                    <button class="btn btn-outline-secondary" type="button" onclick="togglePassVisibility('inputConfirmPassword', 'iconConfirm')">
                                        <i class="bi bi-eye" id="iconConfirm"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="XacNhanMatKhauMoi" class="text-danger small"></span>
                            </div>

                            <!-- Nút bấm submit -->
                            <div class="d-flex align-items-center gap-2 pt-2">
                                <button type="submit" class="btn btn-brand px-4 py-2 shadow-sm d-flex align-items-center gap-2">
                                    <i class="bi bi-check-lg"></i> Cập nhật mật khẩu
                                </button>
                                <a href="javascript:history.back()" class="btn btn-light border px-3 py-2 text-secondary">
                                    Quay lại
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Thông tin tài khoản & Lời khuyên bảo mật -->
            <div class="col-md-5">
                <div class="card card-custom mb-3">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="rounded-circle @(isAdmin ? "bg-warning text-dark" : "bg-primary text-white") fw-bold d-flex align-items-center justify-content-center shadow-sm" style="width: 52px; height: 52px; font-size: 1.25rem;">
                                @(userName.Length > 0 ? userName.Substring(0, 1).ToUpper() : "U")
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0 text-dark">@userName</h6>
                                <div class="small text-muted font-monospace">@@@loginUsername</div>
                                <span class="badge @(isAdmin ? "badge-role-admin" : "badge-role-staff") rounded-pill py-1 px-2 mt-1">
                                    <i class="bi @(isAdmin ? "bi-shield-lock" : "bi-person")"></i> @userRole
                                </span>
                            </div>
                        </div>

                        <div class="p-3 bg-light rounded-3 small">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Phạm vi quyền:</span>
                                <span class="fw-semibold text-dark">@(isAdmin ? "Toàn quyền quản trị" : "Thu ngân / Bán hàng")</span>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Trạng thái:</span>
                                <span class="text-success fw-semibold"><i class="bi bi-check-circle-fill"></i> Đang hoạt động</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Hệ thống:</span>
                                <span class="text-dark">AACH Savor Store</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card card-custom border-warning border-opacity-50" style="background: linear-gradient(180deg, #fffbeb 0%, #ffffff 100%);">
                    <div class="card-body p-4">
                        <h6 class="fw-bold text-dark d-flex align-items-center gap-2 mb-3">
                            <i class="bi bi-shield-check text-warning fs-5"></i> Lưu ý an toàn tài khoản
                        </h6>
                        <ul class="text-secondary small ps-3 mb-0 d-flex flex-column gap-2">
                            <li>Không chia sẻ mật khẩu của bạn cho người khác, kể cả đồng nghiệp.</li>
                            <li>Nên đặt mật khẩu có chữ và số để tăng cường độ bảo mật cho quầy thu ngân.</li>
                            <li>Sau khi đổi mật khẩu, bạn vẫn giữ nguyên phiên làm việc hiện tại và có thể sử dụng mật khẩu mới cho các lần đăng nhập tiếp theo.</li>
                            <li>Nếu quên mật khẩu, vui lòng liên hệ Admin/Quản lý để được hỗ trợ cấp lại.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function togglePassVisibility(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (!input || !icon) return;

            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }
    </script>
}
